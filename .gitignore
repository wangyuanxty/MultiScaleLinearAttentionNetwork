# Only ignore large/third-party data directories; everything else (paper/,
# results/, PDFs, sources) is tracked.

checkpoints/
data/
literature/
reference_repos/

# Local agent tooling: .claude/skills holds vendored third-party skills
# (~39 MB, 744 files).  .claude/settings.json is already tracked and stays
# so -- gitignore only governs untracked files, so no negation is needed.
.claude/

# Working directories and drafts: kept on disk, out of the repo.  These were
# tracked until 2026-09-23; paper_work/ alone carries ~134 MB of generated
# figures, and none of it is needed to build the paper.
docs/
paper_work/
slides_assets/
CLAUDE.md
report_slides.html

# LaTeX build artifacts (paper/ and paper_indojc/)
paper*/**/*.aux
paper*/**/*.log
paper*/**/*.toc
paper*/**/*.fls
paper*/**/*.bbl
paper*/**/*.blg
paper*/**/*.out
paper*/**/*.synctex.gz
paper*/**/*.fdb_latexmk
paper*/**/texput.log
texput.log

# Python caches (all dirs)
__pycache__/
*.pyc
.ruff_cache/
*.egg-info/
.pytest_cache/
.coverage

# IDE
.vscode/

# compiled paper (build artifact; regenerate with pdflatex)
paper*/DeltaCycle_Multi-Scale_Linear_Attention.pdf
paper*/main.pdf

# working numbers ledger -- decisions and current figures, kept local
paper_plan.md
