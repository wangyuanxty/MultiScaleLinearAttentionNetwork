\@writefile{toc}{\contentsline {subsection}{\numberline {C}Multi-scale branches with per-layer cross-scale exchange}{6}{subsection.3.3}\protected@file@percent }
\newlabel{sec:multiscale}{{C}{6}{Multi-scale branches with per-layer cross-scale exchange}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Multi-scale GDN-2 architecture and cross-scale exchange submodule. Top: the fixed window of $W{=}64$ capacity cycles (the tokens $cap_t$; $cyc_t$ denotes the cycle index) is encoded in parallel at three scales (patch 2/4/8, 32/16/8 tokens), embedded per scale, and passed through two GDN-2 layers per branch ($8$\,KB fixed state per layer); the three branches exchange multi-scale information through the per-layer cross-scale exchange (orange arrows, coarse state as query), fuse at the $fuse$ node, and emit the next-cycle capacity prediction $\hat  {c}_{t+1}$ via the last-token readout (Linear\,128 $\to $ GELU $\to $ Linear\,1). Bottom (light-green box): the cross-scale exchange submodule maps the coarse state $S$ (2048 elements) to a single query $q$ ($d_q{=}32$) via $W_q$; single-query attention interacts $q$ with the fine/mid branch keys and values ($k, v$, $d_{\text  {model}}{=}64$) to produce the context $c_f$, added to the fused state: $h_f = h_{\text  {fuse}} + c_f$.}}{7}{figure.caption.2}\protected@file@percent }
\newlabel{fig:arch}{{2}{7}{Multi-scale GDN-2 architecture and cross-scale exchange submodule. Top: the fixed window of $W{=}64$ capacity cycles (the tokens $cap_t$; $cyc_t$ denotes the cycle index) is encoded in parallel at three scales (patch 2/4/8, 32/16/8 tokens), embedded per scale, and passed through two GDN-2 layers per branch ($8$\,KB fixed state per layer); the three branches exchange multi-scale information through the per-layer cross-scale exchange (orange arrows, coarse state as query), fuse at the $fuse$ node, and emit the next-cycle capacity prediction $\hat {c}_{t+1}$ via the last-token readout (Linear\,128 $\to $ GELU $\to $ Linear\,1). Bottom (light-green box): the cross-scale exchange submodule maps the coarse state $S$ (2048 elements) to a single query $q$ ($d_q{=}32$) via $W_q$; single-query attention interacts $q$ with the fine/mid branch keys and values ($k, v$, $d_{\text {model}}{=}64$) to produce the context $c_f$, added to the fused state: $h_f = h_{\text {fuse}} + c_f$}{figure.caption.2}{}}
\newlabel{eq:stagequery}{{4}{7}{Multi-scale branches with per-layer cross-scale exchange}{equation.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {D}Physics-consistent extension: the rate head}{7}{subsection.3.4}\protected@file@percent }
\newlabel{sec:physics}{{D}{7}{Physics-consistent extension: the rate head}{subsection.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces One GDN-2 block. The input token $x_t$ is projected to queries/keys/values ($W_q$: $64\to 64$, $W_k$: $64\to 64$, $W_v$: $64\to 128$), each through a causal 1-D convolution (kernel $k{=}4$, $L2$-normalized for $q$ and $k$), while a shared projection $F_{\mathrm  {proj}}$ generates the erase ($\mathbf  {b}_t$, sigmoid), write ($\mathbf  {w}_t$, sigmoid) and per-channel decay ($\boldsymbol  {\alpha }_t = \exp (g)$) gates; the gated update produces the fixed-size state $\mathbf  {S}_t$ ($4\times 16\times 32$ elements $= 8$\,KB, zero growth), and the output $\mathbf  {o}_t = \mathbf  {S}_t^{\top }\mathbf  {q}_t \to $ Linear $128\to 64 \to $ RMSNorm. }}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:gdn2}{{3}{8}{One GDN-2 block. The input token $x_t$ is projected to queries/keys/values ($W_q$: $64\to 64$, $W_k$: $64\to 64$, $W_v$: $64\to 128$), each through a causal 1-D convolution (kernel $k{=}4$, $L2$-normalized for $q$ and $k$), while a shared projection $F_{\mathrm {proj}}$ generates the erase ($\mathbf {b}_t$, sigmoid), write ($\mathbf {w}_t$, sigmoid) and per-channel decay ($\boldsymbol {\alpha }_t = \exp (g)$) gates; the gated update produces the fixed-size state $\mathbf {S}_t$ ($4\times 16\times 32$ elements $= 8$\,KB, zero growth), and the output $\mathbf {o}_t = \mathbf {S}_t^{\top }\mathbf {q}_t \to $ Linear $128\to 64 \to $ RMSNorm}{figure.caption.3}{}}
\newlabel{fig:decay}{{4a}{8}{\relax }{figure.caption.4}{}}
\newlabel{sub@fig:decay}{{a}{8}{\relax }{figure.caption.4}{}}
\newlabel{fig:cost}{{4b}{8}{\relax }{figure.caption.4}{}}
\newlabel{sub@fig:cost}{{b}{8}{\relax }{figure.caption.4}{}}
\newlabel{fig:patch_pool}{{4c}{8}{\relax }{figure.caption.4}{}}
\newlabel{sub@fig:patch_pool}{{c}{8}{\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Method-consistency evidence. (a) Real per-layer mean decay weights from the seed-42 CALCE checkpoint: each layer keeps state over hundreds of cycles, and the per-channel log-rate gate ($g = -\exp (A_{\log })\,\mathrm  {softplus}(\mathrm  {raw}_g + \mathrm  {dt}_{\mathrm  {bias}})$, $\boldsymbol  {\alpha }_t=\exp (g)$) sets how quickly each channel forgets. (b) Per-window cost of the single-query linear-attention scan ($O(L)$) versus quadratic self-attention ($O(L^2)$). (c) Real multi-scale capacity series of the $W{=}64$ CALCE window under patch sizes $P\in \{2,4,8\}$ (32/16/8 tokens).}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:evidence}{{4}{8}{Method-consistency evidence. (a) Real per-layer mean decay weights from the seed-42 CALCE checkpoint: each layer keeps state over hundreds of cycles, and the per-channel log-rate gate ($g = -\exp (A_{\log })\,\mathrm {softplus}(\mathrm {raw}_g + \mathrm {dt}_{\mathrm {bias}})$, $\boldsymbol {\alpha }_t=\exp (g)$) sets how quickly each channel forgets. (b) Per-window cost of the single-query linear-attention scan ($O(L)$) versus quadratic self-attention ($O(L^2)$). (c) Real multi-scale capacity series of the $W{=}64$ CALCE window under patch sizes $P\in \{2,4,8\}$ (32/16/8 tokens)}{figure.caption.4}{}}
\newlabel{eq:rate_head}{{5}{8}{Physics-consistent extension: the rate head}{equation.5}{}}
