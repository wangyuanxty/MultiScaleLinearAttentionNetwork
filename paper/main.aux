\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The multi-scale GDN-2 encoder: three parallel branches of two layers each (8\,KB fixed state per layer). The $W{=}64$ window is pooled with stride 2/4/8 into 32/16/8 tokens, embedded to $d{=}64$, linked per layer by the stage-query exchange, fused at the last token (192 $\to $ 128 $\to $ GELU $\to $ 1) to predict $\hat  {c}_{t+1}$, which rolls forward.}}{11}{figure.caption.2}\protected@file@percent }
\newlabel{fig:arch}{{2}{11}{The multi-scale GDN-2 encoder: three parallel branches of two layers each (8\,KB fixed state per layer). The $W{=}64$ window is pooled with stride 2/4/8 into 32/16/8 tokens, embedded to $d{=}64$, linked per layer by the stage-query exchange, fused at the last token (192 $\to $ 128 $\to $ GELU $\to $ 1) to predict $\hat {c}_{t+1}$, which rolls forward}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The per-layer stage-query cross-scale exchange: the coarse branch's GDN state $S$ (2048 elements) is projected to a single query ($d_k{=}32$) that sweeps the fine/mid branch $k/v$ streams ($d_{\text  {model}}{=}64$) by single-query linear attention ($O(L)$, no gating), merging additively ($h_f \leftarrow h_f + c_f$).}}{11}{figure.caption.3}\protected@file@percent }
\newlabel{fig:sqx}{{3}{11}{The per-layer stage-query cross-scale exchange: the coarse branch's GDN state $S$ (2048 elements) is projected to a single query ($d_k{=}32$) that sweeps the fine/mid branch $k/v$ streams ($d_{\text {model}}{=}64$) by single-query linear attention ($O(L)$, no gating), merging additively ($h_f \leftarrow h_f + c_f$)}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces One GDN-2 block. The input token $x_t$ is projected to queries/keys/values ($W_q$: $64\to 64$, $W_k$: $64\to 64$, $W_v$: $64\to 128$), each through a causal 1-D convolution (kernel $k{=}4$, $L2$-normalized for $q$ and $k$), while a shared projection $F_{\mathrm  {proj}}$ generates the erase ($\mathbf  {b}_t$, sigmoid), write ($\mathbf  {w}_t$, sigmoid) and per-channel decay ($\boldsymbol  {\alpha }_t = \exp (g)$) gates; the gated update produces the fixed-size state $\mathbf  {S}_t$ ($4\times 16\times 32$ elements $= 8$\,KB, zero growth), and the output $\mathbf  {o}_t = \mathbf  {S}_t^{\top }\mathbf  {q}_t \to $ Linear $128\to 64 \to $ RMSNorm. }}{12}{figure.caption.4}\protected@file@percent }
\newlabel{fig:gdn2}{{4}{12}{One GDN-2 block. The input token $x_t$ is projected to queries/keys/values ($W_q$: $64\to 64$, $W_k$: $64\to 64$, $W_v$: $64\to 128$), each through a causal 1-D convolution (kernel $k{=}4$, $L2$-normalized for $q$ and $k$), while a shared projection $F_{\mathrm {proj}}$ generates the erase ($\mathbf {b}_t$, sigmoid), write ($\mathbf {w}_t$, sigmoid) and per-channel decay ($\boldsymbol {\alpha }_t = \exp (g)$) gates; the gated update produces the fixed-size state $\mathbf {S}_t$ ($4\times 16\times 32$ elements $= 8$\,KB, zero growth), and the output $\mathbf {o}_t = \mathbf {S}_t^{\top }\mathbf {q}_t \to $ Linear $128\to 64 \to $ RMSNorm}{figure.caption.4}{}}
\newlabel{fig:decay}{{5a}{12}{\relax }{figure.caption.5}{}}
\newlabel{sub@fig:decay}{{a}{12}{\relax }{figure.caption.5}{}}
\newlabel{fig:cost}{{5b}{12}{\relax }{figure.caption.5}{}}
\newlabel{sub@fig:cost}{{b}{12}{\relax }{figure.caption.5}{}}
\newlabel{fig:patch_pool}{{5c}{12}{\relax }{figure.caption.5}{}}
\newlabel{sub@fig:patch_pool}{{c}{12}{\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Method-consistency evidence. (a) Real per-layer mean decay weights from the seed-42 CALCE checkpoint: each layer keeps state over hundreds of cycles, and the per-channel log-rate gate ($g = -\exp (A_{\log })\,\mathrm  {softplus}(\mathrm  {raw}_g + \mathrm  {dt}_{\mathrm  {bias}})$, $\boldsymbol  {\alpha }_t=\exp (g)$) sets how quickly each channel forgets. (b) Per-window cost of the single-query linear-attention scan ($O(L)$) versus quadratic self-attention ($O(L^2)$). (c) Real multi-scale capacity series of the $W{=}64$ CALCE window under patch sizes $P\in \{2,4,8\}$ (32/16/8 tokens).}}{12}{figure.caption.5}\protected@file@percent }
\newlabel{fig:evidence}{{5}{12}{Method-consistency evidence. (a) Real per-layer mean decay weights from the seed-42 CALCE checkpoint: each layer keeps state over hundreds of cycles, and the per-channel log-rate gate ($g = -\exp (A_{\log })\,\mathrm {softplus}(\mathrm {raw}_g + \mathrm {dt}_{\mathrm {bias}})$, $\boldsymbol {\alpha }_t=\exp (g)$) sets how quickly each channel forgets. (b) Per-window cost of the single-query linear-attention scan ($O(L)$) versus quadratic self-attention ($O(L^2)$). (c) Real multi-scale capacity series of the $W{=}64$ CALCE window under patch sizes $P\in \{2,4,8\}$ (32/16/8 tokens)}{figure.caption.5}{}}
